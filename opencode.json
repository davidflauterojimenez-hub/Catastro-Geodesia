{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "agente-c-enrutador",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "catastro-qwen:latest": {
          "name": "Qwen 2.5 7B · catastro (local, 4.7 GB)",
          "capabilities": { "tools": true },
          "limit": { "context": 16384, "output": 2048 }
        },
        "geodesia-qwen:latest": {
          "name": "Qwen 2.5 7B · geodesia (local, 4.7 GB)",
          "capabilities": { "tools": true },
          "limit": { "context": 16384, "output": 2048 }
        }
      }
    }
  }
}
